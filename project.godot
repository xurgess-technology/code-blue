; Malpractice — co-op hospital horror. Godot 4.7.

config_version=5

[application]

config/name="Malpractice"
config/version="0.6.7"
config/description="Clock in. Find the tools. Save the patient."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[autoload]

Assets="*res://scripts/assets.gd"
Audio="*res://scripts/audio_manager.gd"
Settings="*res://scripts/settings.gd"
Net="*res://scripts/net.gd"
Loading="*res://scripts/loading_screen.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

